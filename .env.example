# --- Offline pipeline ---------------------------------------------------------
UNIVERSE_FROM=2023-01-01
UNIVERSE_TO=2025-12-31
HTTP_MIN_INTERVAL_S=0.6
HTTP_TIMEOUT_S=30
# REDFLAG_DATA_DIR=./data
# REDFLAG_LOG_DIR=./logs
# SAMPLE_IPOS=NSE-2023-SYNOPTICS        # demo IPOs copied into the sample db

# --- Zetaris (hosted instance; nothing runs locally) --------------------------
ZETARIS_REST_URL=https://your-zetaris-host/api/v1.0
ZETARIS_API_KEY=your-key-here           # Zetaris UI: Management -> API Tokens
ZETARIS_ORG_ID=1
# How the archive reaches Zetaris: "files" (Parquet in a bucket) or "postgres"
ZETARIS_ARCHIVE_ROUTE=files
RF_FILES_BASE=s3a://your-bucket/redflag/parquet   # upload data/publish/parquet here
# RF_PRICES_PATH=s3a://your-bucket/redflag/parquet/prices
# RF_LIVE_BASE=s3a://your-bucket/redflag/parquet/live
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RF_S3_ENDPOINT=s3.ap-south-1.amazonaws.com
# Postgres route: run.py zetaris load-pg, then register (prices included, no bucket)
# RF_PG_JDBC_URL=jdbc:postgresql://your-pg-host:5432/redflag
# RF_PG_USER=redflag
# RF_PG_PASSWORD=

# --- Meterless Nightshift on this Mac (see meterless/README.md) ---------------
# Both values come from Nightshift's Console; check with meterless/check.py
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-console-token
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Model behind each role; a meterless/* route or a pinned id from GET /v1/models
MODEL_ROUTE_EXTRACT=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_ROUTE_REASON=nvidia/nemotron-3-ultra-550b-a55b

# --- Runtime -----------------------------------------------------------------
SAMPLE_MODE=false
RECORD_REPLAY=false                     # true: save live replies for sample mode
RUN_MAX_LLM_CALLS=200
RUN_MAX_TOKENS=400000
LOG_LEVEL=INFO
PORT=8000
